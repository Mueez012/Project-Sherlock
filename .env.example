# Copy to .env (git ignores it); docker compose reads .env automatically.
#   Windows:  Copy-Item .env.example .env        Linux/macOS:  cp .env.example .env

# stub = baseline extractors inside the hub; real = call the service containers.
# docker-compose.yml defaults every module to stub (that is what CI runs); this file switches TTP and IOC to real.
TM_MODEL_MODE=stub
# real = the trained model in the ttp container (CPU by default; docker compose downloads the model on first start).
TM_TTP_MODE=real
# real = IOC-hunter in the ioc container; stub = the hub's regex baseline.
TM_IOC_MODE=real

# Optional provider credentials for IOC-hunter's API-key fallback, passed to the ioc container at runtime.
# They live only in your .env (git ignores it); never put real keys in this file.
OTX_API_KEY=
VT_API_KEY=

# IOC-hunter also extracts emails and CVEs when true (its extended_types); off by default, as in IOC-hunter.
TM_IOC_EXTENDED_TYPES=false

# Host ports. Use TM_PORT=8080 on a machine where port 8000 is already taken (Splunk).
TM_PORT=8000
WEB_PORT=3000

# One collection shared with the host terminal. Container path remains /data.
IOC_HUNTER_HOST_STORE=./services/ioc/output/investigations
# Explicit local development identity; leave empty when injecting real user management.
IOC_HUNTER_LOCAL_ACTOR=local
