# Copy to .env (git ignores it); docker compose reads .env automatically.
#   Windows:  Copy-Item .env.example .env        Linux/macOS:  cp .env.example .env

# stub = baseline extractors inside the hub; real = call the service containers.
# Compose includes the real IOC service; TTP uses its baseline by default.
TM_MODEL_MODE=stub
# Empty TTP mode follows TM_MODEL_MODE. Set real after configuring a TTP service.
TM_TTP_MODE=
# Compose defaults to real for IOC; set stub to use the baseline extractor instead.
TM_IOC_MODE=real

# Optional provider credentials, passed to the IOC container at runtime.
OTX_API_KEY=
VT_API_KEY=

# IOC-hunter also extracts emails and CVEs when true (its extended_types); off by default, as in IOC-hunter.
TM_IOC_EXTENDED_TYPES=false

# Host ports. Use TM_PORT=8080 on a machine where port 8000 is already taken (Splunk).
TM_PORT=8000
WEB_PORT=3000
