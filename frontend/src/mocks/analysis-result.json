     "p": 0.6632,
     "passed": true
    }
   ]
  },
  {
   "index": 11,
   "text": "The archive was exfiltrated over HTTPS to a cloud storage account controlled by the attackers.",
   "char_start": 1210,
   "char_end": 1304,
   "page": null,
   "skipped": null,
   "labels": [
    {
